# ─────────────────────────────────────────────────────────────
# Storinka Backend — env variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ─── Database (Supabase Postgres) ────────────────────────────
# Get your connection string from:
#   Supabase Dashboard → Project Settings → Database → Connection string → JDBC
#
# Three connection modes available in Supabase. Pick ONE.
#
# A) Direct connection (port 5432, host: db.<PROJECT_REF>.supabase.co)
#    Pros: simplest, full Postgres features. Cons: IPv6-only — your ISP must support IPv6.
#    SPRING_DATASOURCE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
#    SPRING_DATASOURCE_USERNAME=postgres
#
# B) Session pooler (port 5432, host: aws-0-<REGION>.pooler.supabase.com) — RECOMMENDED
#    Works over IPv4. Supports persistent prepared statements (safe for JPA/Hibernate).
#    SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
#    SPRING_DATASOURCE_USERNAME=postgres.<PROJECT_REF>
#
# C) Transaction pooler (port 6543) — DO NOT USE with Hibernate.
#    Prepared statements break in transaction-mode pgbouncer.

SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.PROJECT_REF
SPRING_DATASOURCE_PASSWORD=

# Optional Hikari tuning
DB_POOL_MAX=10

# ─── JWT ─────────────────────────────────────────────────────
# Must be at least 32 chars (HMAC-SHA256 requires 256-bit key).
JWT_SECRET=replace-with-at-least-32-chars-long-secret
JWT_EXPIRATION=604800000

# ─── Mail (SMTP) ─────────────────────────────────────────────
# Dev: Mailtrap sandbox (https://mailtrap.io) — emails caught in web UI.
# Prod: Gmail SMTP, Resend, SendGrid, etc.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@storinka.ua

# ─── URLs ────────────────────────────────────────────────────
# Used in verification email links and redirects.
APP_BACKEND_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000

# ─── Google OAuth ───────────────────────────────────────────
# Create OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Type: Web application. Authorized JavaScript origins should include
# http://localhost:3000 (dev) and your production frontend URL.
# Only the client ID is needed — ID tokens are verified by signature, not
# by exchanging an authorization code, so no client secret is required.
GOOGLE_CLIENT_ID=

# ─── Server ──────────────────────────────────────────────────
SERVER_PORT=8080
